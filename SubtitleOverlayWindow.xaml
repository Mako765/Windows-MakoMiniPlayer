<Window x:Class="MakoMiniPlayer.SubtitleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MakoMiniPlayer"
        Title="SubtitleOverlay"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        Focusable="False">

    <Grid>
        <local:OutlinedTextBlock
            x:Name="TxtSubtitle"
            VisibilityEx="Collapsed"
            FontSize="32"
            Foreground="White"
            Stroke="Black"
            StrokeThickness="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="800"
            Margin="0,300,0,0"/>
    </Grid>
</Window>