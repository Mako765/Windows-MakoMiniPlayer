<Window x:Class="MakoMiniPlayer.SubtitleStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stil titlova" Height="720" Width="520"
        Background="#1a1a1a" Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Margin="20,20,20,0">
            <StackPanel>

                <!-- Veličina -->
                <TextBlock Foreground="#aaaaaa" Margin="0,0,0,4">
                    <Run Text="Veličina: "/>
                    <Run x:Name="TxtSizeLabel" Text="32"/>
                    <Run Text="sp"/>
                </TextBlock>
                <Slider x:Name="SliderSize"
                        Minimum="12" Maximum="80" Value="32"
                        Margin="0,0,0,16"
                        ValueChanged="SliderSize_ValueChanged"/>

                <!-- Pozicija -->
                <TextBlock Foreground="#aaaaaa" Margin="0,0,0,4">
                    <Run Text="Pozicija od dna: "/>
                    <Run x:Name="TxtMarginLabel" Text="5"/>
                    <Run Text="% (0=dno, 95=vrh)"/>
                </TextBlock>
                <Slider x:Name="SliderMargin"
                        Minimum="0" Maximum="95" Value="5"
                        Margin="0,0,0,16"
                        ValueChanged="SliderMargin_ValueChanged"/>

                <!-- Checkboxes -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <CheckBox x:Name="ChkBold" Content="Bold"
                              Foreground="White" Margin="0,0,24,0"/>
                    <CheckBox x:Name="ChkShadow" Content="Sjenka"
                              Foreground="White"/>
                </StackPanel>

                <!-- Pozadina opacity -->
  
                <!-- Shadow jačina -->
                <TextBlock Foreground="#aaaaaa" Margin="0,0,0,4">
                    <Run Text="Jačina sjenke: "/>
                    <Run x:Name="TxtShadowLabel" Text="6"/>
                </TextBlock>
                <Slider x:Name="SliderShadow"
                        Minimum="1" Maximum="20" Value="6"
                        Margin="0,0,0,16"
                        ValueChanged="SliderShadow_ValueChanged"/>

                <!-- Outline -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="ChkOutline" Content="Outline"
                              Foreground="White" VerticalAlignment="Center"
                              Margin="0,0,16,0"/>
                    <TextBlock Foreground="#aaaaaa" VerticalAlignment="Center">
                        <Run Text="Debljina: "/>
                        <Run x:Name="TxtOutlineLabel" Text="2.0"/>
                    </TextBlock>
                </StackPanel>
                <Slider x:Name="SliderOutline"
                        Minimum="0" Maximum="8" Value="2"
                        Margin="0,0,0,16"
                        ValueChanged="SliderOutline_ValueChanged"/>

                <!-- Boja teksta -->
                <TextBlock Text="Boja teksta:"
                           Foreground="#aaaaaa" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbColor" Margin="0,0,0,16"/>

                <!-- Boja outlinea -->
                <TextBlock Text="Boja outlinea:"
                           Foreground="#aaaaaa" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbOutlineColor" Margin="0,0,0,8"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Preview -->
        <Border Grid.Row="1" Background="#222222"
                Margin="20,8,20,8"
                Padding="12" MinHeight="60">
            <TextBlock x:Name="TxtPreview"
                       Text="Primjer titla — Sample subtitle"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="32"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,0,20,16">
            <Button Content="Primijeni" Width="100" Height="34"
                    Background="#0078d4" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Margin="0,0,8,0"
                    Click="BtnApply_Click"/>
            <Button Content="Odustani" Width="100" Height="34"
                    Background="#333333" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>