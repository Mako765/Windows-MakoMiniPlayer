<Window x:Class="MakoMiniPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="MakoMiniPlayer" Height="520" Width="900"
        MinHeight="300" MinWidth="480"
        Background="#0d0520"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PlayerBtn" TargetType="Button">
            <Setter Property="Background" Value="#2d1a4e"/>
            <Setter Property="Foreground" Value="#00ff88"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#3d2a6e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#1a0a3e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00ff88"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#3d2a6e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00ff88"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#cc2244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2d1a4e"/>
            <Setter Property="Foreground" Value="#00ff88"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#00aa55"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#3d2a6e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekBarStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#00ff88"
                                                        Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12"
                                                         Fill="#00ff88"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#2d1a4e"
                                                        Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeBarStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#00cc66"
                                                        Height="3" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="10" Height="10"
                                                         Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#2d1a4e"
                                                        Height="3" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0d0520" Offset="0"/>
                    <GradientStop Color="#1a0a2e" Offset="0.5"/>
                    <GradientStop Color="#0d0520" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="◆" Foreground="#00ff88" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Mako" Foreground="#00ff88"
                           FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Mini" Foreground="#7744cc"
                           FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Player" Foreground="#00ff88"
                           FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitleFile" Foreground="#666688"
                           FontSize="11" VerticalAlignment="Center"
                           Margin="10,0,0,0" Text=""/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="─" Style="{StaticResource TitleBarBtn}"
                        Click="TitleBar_Minimize"/>
                <Button x:Name="BtnMaxRestore" Content="□"
                        Style="{StaticResource TitleBarBtn}"
                        Click="TitleBar_MaxRestore"/>
                <Button Content="✕" Style="{StaticResource TitleBarCloseBtn}"
                        Click="TitleBar_Close"/>
            </StackPanel>
            <Border VerticalAlignment="Bottom" Height="1"
                    Background="#00ff88" Opacity="0.3"/>
        </Grid>

        <!-- Video Area -->
        <Grid Grid.Row="1" Background="Black">
            <vlc:VideoView x:Name="VideoView" Background="Black"
                           Visibility="Hidden"/>
        </Grid>
        <!-- Controls Bar -->
        <Grid Grid.Row="2" x:Name="ControlsBar">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1a0a2e" Offset="0"/>
                    <GradientStop Color="#0d0520" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Seek Bar -->
            <Grid Grid.Row="0" Margin="8,6,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="M" Grid.Column="0" Foreground="#00ff88"
                           FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider x:Name="SeekBar" Grid.Column="1"
                        Style="{StaticResource SeekBarStyle}"
                        Minimum="0" Maximum="10000" Value="0"
                        VerticalAlignment="Center"
                        IsMoveToPointEnabled="True"
                        ValueChanged="SeekBar_ValueChanged"
                        PreviewMouseDown="SeekBar_PreviewMouseDown"
                        PreviewMouseUp="SeekBar_PreviewMouseUp"/>
            </Grid>

            <!-- Buttons Row 1 -->
            <Grid Grid.Row="1" Margin="8,2,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPlayPause" Grid.Column="0"
                        Content="▶" Width="36" Height="36"
                        Style="{StaticResource PlayerBtn}"
                        Click="BtnPlayPause_Click"/>
                <Button x:Name="BtnStop" Grid.Column="1"
                        Content="⏹" Width="36" Height="36" Margin="3,0,0,0"
                        Style="{StaticResource PlayerBtn}"
                        Click="BtnStop_Click"/>
                <Button Grid.Column="2"
                        Content="⏪5m" Width="44" Height="36" Margin="3,0,0,0"
                        Style="{StaticResource PlayerBtn}" FontSize="11"
                        Click="Skip_Minus5_Click"/>
                <Button Grid.Column="3"
                        Content="5m⏩" Width="44" Height="36" Margin="3,0,0,0"
                        Style="{StaticResource PlayerBtn}" FontSize="11"
                        Click="Skip_Plus5_Click"/>
                <Button x:Name="BtnMute" Grid.Column="4" Content="🔊"
                        Width="28" Height="28" Margin="6,0,2,0"
                        Style="{StaticResource PlayerBtn}" FontSize="14"
                        Click="BtnMute_Click"/>
                <Slider x:Name="VolumeBar" Grid.Column="5"
                        Style="{StaticResource VolumeBarStyle}"
                        Width="80" Minimum="0" Maximum="100" Value="80"
                        VerticalAlignment="Center"
                        ValueChanged="VolumeBar_ValueChanged"/>
                <TextBlock x:Name="TxtTime" Grid.Column="6"
                           Text="00:00:00 / 00:00:00"
                           Foreground="#aaaaaa" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="12"/>
                <Button Grid.Column="7" Content="◀sub" Width="46" Height="26"
                        Style="{StaticResource PlayerBtn}" FontSize="10"
                        Margin="4,0,0,0" Click="BtnSubMinus_Click"/>
                <TextBlock x:Name="TxtSubOffset" Grid.Column="8" Text="+0.0s"
                           Foreground="#00ff88" FontSize="11"
                           VerticalAlignment="Center" Margin="3,0,3,0"
                           MinWidth="38" TextAlignment="Center"/>
                <Button Grid.Column="9" Content="sub▶" Width="46" Height="26"
                        Style="{StaticResource PlayerBtn}" FontSize="10"
                        Click="BtnSubPlus_Click"/>
                <ComboBox x:Name="CmbAudio" Grid.Column="10"
                          Width="100" Height="28" Margin="4,0,0,0"
                          ToolTip="Audio track"
                          SelectionChanged="CmbAudio_SelectionChanged"/>
                <Button x:Name="BtnSubtitles" Grid.Column="11"
                        Content="💬 Titlovi" Width="74" Height="36" Margin="3,0,0,0"
                        Style="{StaticResource PlayerBtn}" FontSize="11"
                        Click="BtnSubtitles_Click"/>
            </Grid>

            <!-- Buttons Row 2 -->
            <Grid Grid.Row="2" Margin="8,0,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnAspect" Grid.Column="0"
                        Content="Aspect: Default" Width="100" Height="26"
                        Style="{StaticResource PlayerBtn}"
                        FontSize="10" ToolTip="Aspect ratio"
                        Click="BtnAspect_Click"/>
                <Button Grid.Column="1"
                        Content="⛶ Fullscreen" Width="90" Height="26" Margin="3,0,0,0"
                        Style="{StaticResource PlayerBtn}" FontSize="10"
                        Click="BtnFullscreen_Click"/>
                <Button Grid.Column="2"
                        Content="📷 Screenshot" Width="100" Height="26" Margin="3,0,0,0"
                        Style="{StaticResource PlayerBtn}" FontSize="10"
                        Click="BtnScreenshot_Click"/>
                <ToggleButton x:Name="BtnOnTop" Grid.Column="3"
                              Content="📌 Na vrhu" Width="76" Height="26" Margin="3,0,0,0"
                              Style="{StaticResource PlayerToggleBtn}" FontSize="10"
                              Checked="BtnOnTop_Checked"
                              Unchecked="BtnOnTop_Unchecked"/>
                <Button x:Name="BtnOpen" Grid.Column="4"
                        Content="📂 Otvori" Width="76" Height="26" Margin="3,0,8,0"
                        Style="{StaticResource PlayerBtn}" FontSize="10"
                        Click="BtnOpen_Click"/>
                <ScrollViewer Grid.Column="5"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RecentPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>