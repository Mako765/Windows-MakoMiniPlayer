<Window x:Class="MakoMiniPlayer.SubtitleSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pretraži titlove" Height="680" Width="500"
        Background="#1a1a1a" Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RbOpenSub" Content="OpenSubtitles.com"
                         IsChecked="True" Foreground="White"
                         VerticalContentAlignment="Center" Margin="0,0,16,0"/>
            <RadioButton x:Name="RbSubDL" Content="SubDL"
                         Foreground="White" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Naziv -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Naziv:" VerticalAlignment="Center" Foreground="#aaaaaa"/>
            <TextBox x:Name="TxtQuery" Grid.Column="1"
                     Background="#333333" Foreground="White"
                     BorderBrush="#555555" Padding="6,4"/>
        </Grid>

        <!-- Sezona / Epizoda -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Sezona:" VerticalAlignment="Center" Foreground="#aaaaaa"/>
            <TextBox x:Name="TxtSeason" Grid.Column="1"
                     Background="#333333" Foreground="White"
                     BorderBrush="#555555" Padding="6,4" Margin="0,0,8,0"/>
            <TextBlock Text="Epizoda:" Grid.Column="2"
                       VerticalAlignment="Center" Foreground="#aaaaaa"/>
            <TextBox x:Name="TxtEpisode" Grid.Column="3"
                     Background="#333333" Foreground="White"
                     BorderBrush="#555555" Padding="6,4"/>
        </Grid>

        <!-- Jezici multi-select -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Jezici:" VerticalAlignment="Top"
                       Margin="0,4,0,0" Foreground="#aaaaaa"/>
            <ListBox x:Name="LstLanguages" Grid.Column="1"
                     SelectionMode="Multiple"
                     Height="90"
                     BorderBrush="#555555"/>
        </Grid>

        <!-- Encoding -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Encoding:" VerticalAlignment="Center" Foreground="#aaaaaa"/>
            <ComboBox x:Name="CmbEncoding" Grid.Column="1"/>
        </Grid>

        <!-- Gumbi -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSearch" Content="🔍 Pretraži"
                    Grid.Column="1"
                    Height="32" Padding="16,0" Margin="0,0,8,0"
                    Background="#0078d4" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnSearch_Click"/>
            <Button x:Name="BtnSettings" Content="⚙️ API"
                    Grid.Column="2"
                    Height="32" Padding="12,0"
                    Background="#333333" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnSettings_Click"/>
        </Grid>

        <!-- Rezultati -->
        <ListBox x:Name="LstResults" Grid.Row="6"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- Status + Download -->
        <Grid Grid.Row="7" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus"
                       Text="Upiši naziv i pritisni Pretraži"
                       Foreground="#aaaaaa" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <Button x:Name="BtnDownload" Content="⬇️ Preuzmi"
                    Grid.Column="1"
                    Height="32" Padding="16,0"
                    Background="#00aa44" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    IsEnabled="False"
                    Click="BtnDownload_Click"/>
        </Grid>
    </Grid>
</Window>